{
  "name": "screener-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:webos": "node scripts/build-webos.js",
    "webos:package": "ares-package build -o webos-builds",
    "webos:package-no-minify": "ares-package build --no-minify -o webos-builds",
    "webos:package-verbose": "ares-package build -v -o webos-builds",
    "webos:install-sdk": "chmod +x scripts/install-webos-sdk.sh && ./scripts/install-webos-sdk.sh",
    "webos:install": "ares-install webos-builds/*.ipk",
    "webos:launch": "ares-launch com.silwork.screener",
    "webos:uninstall": "ares-uninstall com.silwork.screener",
    "webos:debug": "ares-inspect com.silwork.screener",
    "webos:setup": "ares-setup-device",
    "webos:device-list": "ares-device-list"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.83.0",
    "@vercel/blob": "^1.1.1",
    "axios": "^1.10.0",
    "express": "^4.18.2",
    "next": "15.4.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
